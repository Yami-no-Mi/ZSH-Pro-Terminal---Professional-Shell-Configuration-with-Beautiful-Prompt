# Function to get git branch
git_branch_info() {
    local branch
    branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
    if [ -n "$branch" ] && [ "$branch" != "HEAD" ]; then
        echo " %F{yellow}($branch)%f"
    fi
}

# Function to get git status (dirty/clean)
git_status_icon() {
    if git rev-parse --git-dir > /dev/null 2>&1; then
        if git diff --quiet 2>/dev/null; then
            echo ""
        else
            echo " %F{red}●%f"
        fi
    fi
}

# PROMPT Line 1: User@Host + Path + Git Info
PROMPT='%F{magenta}╭─%f %F{green}%n%f%F{white}@%f%F{blue}%m%f %F{cyan}%~%f$(git_branch_info)$(git_status_icon)
'

# PROMPT Line 2: Arrow for input
PROMPT+='%F{magenta}╰─%f %F{green}❯%f '

# Right side (optional)
RPROMPT=''

